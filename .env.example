# Copy to .env and `export $(cat .env | xargs)` (or let your IDE load it)
LAKE_ROOT=./data
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8
COMPANY_FUZZY_THRESHOLD=88
# dbt reads these (defaults shown)
SILVER_PATH=./data/silver/complaints
COMPANY_MAP_PATH=./data/silver/company_map
DBT_DUCKDB_PATH=./data/warehouse/cfpb.duckdb

# Snowflake Cloud Warehouse Target (Optional)
SNOWFLAKE_ACCOUNT=your_account_id
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CFPB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_SILVER_SCHEMA=SILVER
